---
import BaseLayout from '../layouts/BaseLayout.astro';
import IfuDocument from '../components/IfuDocument.astro';
---
<BaseLayout
  title="Koios · Instructions for use — healthcare professionals"
  description="The official Parkiwatch instructions for use for healthcare professionals — available in English, Dutch, French and German."
  page="ifu-hcps"
>

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">Instructions for use</span>
      <h1 style="margin-top:18px">For healthcare <em>professionals</em>.</h1>
    </div>
    <p class="lead" style="margin-top:22px">The official instructions for use for the Parkiwatch system, intended for healthcare professionals. A separate guide exists for people with Parkinson&rsquo;s disease.</p>
  </div>
</section>

<!-- DOCUMENT -->
<section style="padding-top:calc(20px*var(--density))">
  <div class="wrap">
    <IfuDocument
      slug="ifu-hcps"
      docTitle="Parkiwatch instructions for use — healthcare professionals"
      paperCopyNote={`<strong>Requesting a paper copy of the Instructions for Use.</strong> These Instructions for Use are supplied in electronic form. A paper copy may be requested at any time, at no cost and without justification, by contacting Koios Care at <a href="mailto:support@koios.care">support@koios.care</a> with the recipient&rsquo;s name and postal address. The paper copy will be dispatched within 7 calendar days of receipt of the request. The current version is always available at <a href="https://www.koios.care">www.koios.care</a>.`}
    />
    <p class="ifu-cross reveal">Looking for the patient guide? See the <a href="/ifu-patients">instructions for use for people with Parkinson&rsquo;s</a> &middot; or check <a href="/compatibility">which smartwatches are compatible</a>.</p>
  </div>
</section>

</BaseLayout>

<style is:global>
  .ifu-cross{margin-top:22px;font-size:14.5px;color:var(--ink-mid)}
  .ifu-cross a{color:var(--primary);font-weight:500;border-bottom:1px solid var(--line-strong)}
  .ifu-cross a:hover{border-bottom-color:var(--primary)}
</style>
