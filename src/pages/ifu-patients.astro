---
import BaseLayout from '../layouts/BaseLayout.astro';
import IfuDocument from '../components/IfuDocument.astro';
---
<BaseLayout
  title="Koios · Instructions for use — patients"
  description="The official Parkiwatch instructions for use for people with Parkinson's disease — available in English, Dutch, French and German."
  page="ifu-patients"
>

<!-- HERO -->
<section class="page-hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">Instructions for use</span>
      <h1 style="margin-top:18px">For people with <em>Parkinson&rsquo;s</em>.</h1>
    </div>
    <p class="lead" style="margin-top:22px">The official instructions for use for the Parkiwatch system, intended for people with Parkinson&rsquo;s disease. Please read this guide before first use and keep it for reference.</p>
  </div>
</section>

<!-- DOCUMENT -->
<section style="padding-top:calc(20px*var(--density))">
  <div class="wrap">
    <IfuDocument
      slug="ifu-patients"
      docTitle="Parkiwatch instructions for use — people with Parkinson's disease"
      version="4"
      paperCopyNote={`<strong>Requesting a paper copy of these Instructions for Use.</strong> These Instructions for Use are provided electronically. You can ask for a printed copy at any time, free of charge. To request one, contact Koios Care at <a href="mailto:support@koios.care">support@koios.care</a> with your name and postal address. Your paper copy will be sent to you within 7 calendar days of your request. The current version is also always available at <a href="https://www.koios.care">www.koios.care</a>.`}
    />
    <p class="ifu-cross reveal">Are you a clinician? See the <a href="/ifu-hcps">instructions for use for healthcare professionals</a> &middot; or check <a href="/compatibility">which smartwatches are compatible</a>.</p>
  </div>
</section>

</BaseLayout>

<style is:global>
  .ifu-cross{margin-top:22px;font-size:14.5px;color:var(--ink-mid)}
  .ifu-cross a{color:var(--primary);font-weight:500;border-bottom:1px solid var(--line-strong)}
  .ifu-cross a:hover{border-bottom-color:var(--primary)}
</style>
